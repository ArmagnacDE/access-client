    "./op-vault": "./src/op-vault.js",
    "./op-token": "./src/op-token.js",
    "./op-read": "./src/op-read.js",
    "./read": "./src/read/cli.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "access-read": "bin/access-read.mjs"
  },
  "files": [
    "src/",
    "bin/",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
